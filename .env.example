# OpenAI-compatible LLM used by PDFMathTranslate and OCR table translation.
API_KEY=
BASE_URL=
MODEL_NAME=
SOURCE_LANGUAGE=auto
TARGET_LANGUAGE=zh-CN
MAX_WORKERS=4
# This repository is pharmaceutical/CMC-oriented. Set false only for a
# deliberately general-domain deployment with its own terminology QA.
ENFORCE_CMC_TERMINOLOGY=true

# Existing remote PP-StructureV3 service. Never expose this token to browsers.
PADDLEOCR_ENABLED=true
PADDLEOCR_API_URL=http://192.168.1.88:18093
PADDLEOCR_API_PATH=/api/v1/structure
PADDLEOCR_SERVICE_TOKEN=
PADDLEOCR_TIMEOUT_SECONDS=3600

# Standalone service storage and concurrency.
STORAGE_DIR=/data/ocr-pdf-agent
MAX_UPLOAD_MIB=200
MAX_CONCURRENT_JOBS=2
# Optional. When set, every /v1/* request must send X-OCR-PDF-Agent-Token.
SERVICE_API_TOKEN=

# Optional Hugging Face mirror for the PDFMathTranslate layout model.
PDFMATH_TRANSLATE_HF_ENDPOINT=
PDFMATH_TRANSLATE_MAX_ATTEMPTS=3
STRICT_OUTPUT_QA=true

# PDF Translator-compatible background rendering and strict visual verification.
LAYOUT_BACKGROUND_DPI=300
LAYOUT_SIMILARITY_DPI=36
LAYOUT_SIMILARITY_MARGIN=2.0
LAYOUT_MIN_SIMILARITY=0.985
LAYOUT_BODY_FONT_SIZE=9.0
LAYOUT_BODY_MIN_FONT_SIZE=6.0
